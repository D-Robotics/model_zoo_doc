# Algolia indexer (scripts/algolia-index.mjs)
# Copy to .env locally. .env is gitignored; the Admin key must never be committed.

# Required for a real (non dry-run) upload. Admin or Write key.
ALGOLIA_ADMIN_API_KEY=

# Optional overrides (defaults match docusaurus.config.js)
ALGOLIA_APP_ID=1VU781LYTV
ALGOLIA_INDEX_NAME=model_zoo_doc
ALGOLIA_SITE_URL=https://developer.d-robotics.cc/model_zoo_doc/
ALGOLIA_DEFAULT_LOCALE=zh-Hans
ALGOLIA_FETCH_CONCURRENCY=8

# Optional probe keyword (defaults to RDK)
# ALGOLIA_PROBE_KEYWORD=RDK
